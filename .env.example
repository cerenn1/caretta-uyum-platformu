# Bu dosya bir ŞABLONDUR — gerçek değerleri buraya yazma, .env dosyasına yaz.
# .env dosyası .gitignore'da olduğu için GitHub'a yüklenmez.

# Veritabanı (Supabase PostgreSQL bağlantı bilgisi)
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani_adi"

# Supabase proje bilgileri (Supabase Dashboard > Project Settings > API'den alınır)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="buraya-supabase-anon-key-yaz"
SUPABASE_SERVICE_ROLE_KEY="buraya-supabase-service-role-key-yaz-ASLA-PAYLASMA"

# JWT
JWT_SECRET="rastgele-uzun-bir-gizli-anahtar-uret"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Claude API (rapor üretimi için, ileri fazda kullanılacak)
ANTHROPIC_API_KEY="buraya-claude-api-anahtarini-yaz-ASLA-PAYLASMA"

# Uygulama
PORT=8080
SPRING_PROFILES_ACTIVE="development"
